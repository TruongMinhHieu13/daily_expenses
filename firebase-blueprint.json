{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account profile",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "User full name"
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar URL"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp string"
        }
      },
      "required": ["uid", "email"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial income or expense transaction record",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Transaction unique identifier"
        },
        "userId": {
          "type": "string",
          "description": "Owner user ID"
        },
        "type": {
          "type": "string",
          "enum": ["expense", "income"],
          "description": "Transaction type"
        },
        "amount": {
          "type": "number",
          "description": "Amount in VNĐ"
        },
        "categoryId": {
          "type": "string",
          "description": "Category ID"
        },
        "note": {
          "type": "string",
          "maxLength": 300,
          "description": "Description or note"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Date in YYYY-MM-DD"
        },
        "time": {
          "type": "string",
          "description": "Time in HH:mm"
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["cash", "bank", "e_wallet"],
          "description": "Payment method"
        },
        "createdAt": {
          "type": "number",
          "description": "Creation timestamp epoch"
        },
        "updatedAt": {
          "type": "number",
          "description": "Last updated epoch"
        }
      },
      "required": ["id", "userId", "type", "amount", "categoryId", "date", "paymentMethod"]
    },
    "Category": {
      "title": "Category",
      "description": "Custom income or expense category",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Category unique ID"
        },
        "userId": {
          "type": "string",
          "description": "Owner user ID"
        },
        "name": {
          "type": "string",
          "maxLength": 60,
          "description": "Category name"
        },
        "type": {
          "type": "string",
          "enum": ["expense", "income"],
          "description": "Category type"
        },
        "icon": {
          "type": "string",
          "description": "Icon identifier"
        },
        "color": {
          "type": "string",
          "description": "Hex color code"
        },
        "isCustom": {
          "type": "boolean",
          "description": "True if custom category"
        }
      },
      "required": ["id", "userId", "name", "type", "icon", "color"]
    },
    "UserSettings": {
      "title": "UserSettings",
      "description": "User preferences and security settings",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "User UID"
        },
        "hideBalance": {
          "type": "boolean",
          "description": "Whether balance is masked"
        },
        "pinEnabled": {
          "type": "boolean",
          "description": "Whether PIN code protection is enabled"
        },
        "pinCode": {
          "type": "string",
          "maxLength": 4,
          "description": "4-digit PIN code"
        },
        "currency": {
          "type": "string",
          "description": "Currency code VND"
        },
        "monthlyBudget": {
          "type": "number",
          "description": "Target monthly budget in VNĐ"
        }
      },
      "required": ["userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User account document"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "User financial transactions"
    },
    "/users/{userId}/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "User custom categories"
    },
    "/users/{userId}/settings/preferences": {
      "schema": { "$ref": "#/entities/UserSettings" },
      "description": "User app preferences"
    }
  }
}
